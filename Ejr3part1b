#include <stdint.h>
#include <stdbool.h>
#include "inc/hw_memmap.h"
#include "driverlib/debug.h"
#include "driverlib/gpio.h"
#include "driverlib/sysctl.h"

#ifdef DEBUG
void
__error__(char *pcFilename, uint32_t ui32Line)
{
    while(1);
}
#endif

int main(void)
{   
    // Configurar el reloj del sistema a 120 MHz
    SysCtlClockFreqSet((SYSCTL_XTAL_25MHZ | SYSCTL_OSC_MAIN | 
                        SYSCTL_USE_PLL | SYSCTL_CFG_VCO_480), 120000000);  
    
    // -------------- EJERCICIO 3: --------------
    // Habilitar los puertos N, F y J (LEDs: PN0, PN1, PF0, PF4 / Pulsadores: PJ0 y PJ1)
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPION);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPIOF);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPIOJ);

    // Esperar a que el puerto N, F y J esten listos
    while(!SysCtlPeripheralReady(SYSCTL_PERIPH_GPION)) {}
    while(!SysCtlPeripheralReady(SYSCTL_PERIPH_GPIOF)) {}
    while(!SysCtlPeripheralReady(SYSCTL_PERIPH_GPIOJ)) {}
    
    //Configurar PN0, PN1, PF0 y PF4 como salidas digitales
    GPIOPinTypeGPIOOutput(GPIO_PORTN_BASE, GPIO_PIN_0 | GPIO_PIN_1);
    GPIOPinTypeGPIOOutput(GPIO_PORTF_BASE, GPIO_PIN_0 | GPIO_PIN_4);
    
    //Configurar PJ0 y PJ1 como una entradas digitales (Pulsadores)
    GPIOPinTypeGPIOInput(GPIO_PORTJ_BASE, GPIO_PIN_0 | GPIO_PIN_1);
    //Activar la resistencia interna de pull-up para los pulsadores
    GPIOPadConfigSet(GPIO_PORTJ_BASE, GPIO_PIN_0 | GPIO_PIN_1, GPIO_STRENGTH_2MA, GPIO_PIN_TYPE_STD_WPU);
    
    //Apagamos las salidas
    GPIOPinWrite(GPIO_PORTN_BASE, GPIO_PIN_0 | GPIO_PIN_1, 0x0);
    GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_0 | GPIO_PIN_4, 0x0);
    
    //Declaramos la variable contadora
    int c = 0;
    
    while(1)
    {
    	//Leer el estado del pulsador de incremento
    	if(GPIOPinRead(GPIO_PORTJ_BASE, GPIO_PIN_1) == 0)
    	{
    		//Elimina el debouncing
    		while(GPIOPinRead(GPIO_PORTJ_BASE, GPIO_PIN_1) == 0){SysCtlDelay(10000);}
    		//Incrementa el contador
    		c+=1;
    		//Mantiene el contador
    		if(c>=16) c = 15;
    	}
    	//Leer el estado del pulsador de decremento
    	if(GPIOPinRead(GPIO_PORTJ_BASE, GPIO_PIN_0) == 0)
    	{
    		//Elimina el debouncing
    		while(GPIOPinRead(GPIO_PORTJ_BASE, GPIO_PIN_0) == 0){SysCtlDelay(10000);}
    		//Decrementa el contador
    		c-=1;
    		//Mantiene el contador
    		if(c<=0) c = 0;
    	}
    	//Encendemos los leds como corresponde
    	// Mostrar el contador en LEDs (4 bits → 4 LEDs)
        GPIOPinWrite(GPIO_PORTN_BASE, GPIO_PIN_1, (c & 0x1) ? GPIO_PIN_1 : 0);
        GPIOPinWrite(GPIO_PORTN_BASE, GPIO_PIN_0, (c & 0x2) ? GPIO_PIN_0 : 0);
        GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_4, (c & 0x4) ? GPIO_PIN_4 : 0);
        GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_0, (c & 0x8) ? GPIO_PIN_0 : 0);
    }
    return 0;
}