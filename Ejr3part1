// Ejr3
//*****************************************************************************
int main(void)
{
    volatile uint32_t ui32Loop;
    int bin = 0;
    int binAnt = 0;
    int l[4] = {0};
    int i;
    int j;
    
    SysCtlClockFreqSet((SYSCTL_XTAL_25MHZ | SYSCTL_OSC_MAIN | SYSCTL_USE_PLL | SYSCTL_CFG_VCO_480),120000000); 
    // Enable, configure system clock
    
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPION);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPIOF);
    SysCtlPeripheralEnable(SYSCTL_PERIPH_GPIOJ);
    // Enable peripheral N,F,J

    while(!SysCtlPeripheralReady(SYSCTL_PERIPH_GPION))
    {
    }
    while(!SysCtlPeripheralReady(SYSCTL_PERIPH_GPIOF))
    {
    }
    while(!SysCtlPeripheralReady(SYSCTL_PERIPH_GPIOJ))
    {
    }
    // Check access availability of peripheral
    
    GPIOPinTypeGPIOOutput(GPIO_PORTN_BASE, 0x03); // Enable pin 0 and 1
    GPIOPinTypeGPIOOutput(GPIO_PORTF_BASE, 0x11); // Enable pin 0 and 1
    GPIOPinTypeGPIOInput(GPIO_PORTJ_BASE, 0x00);
      GPIOPadConfigSet(GPIO_PORTJ_BASE,GPIO_PIN_0|GPIO_PIN_1,GPIO_STRENGTH_2MA, GPIO_PIN_TYPE_STD_WPD);
      // Enable pin 0 and 1 as pull down

    while(1)
    {
      if ((GPIOPinRead(GPIO_PORTJ_BASE, GPIO_PIN_0)==1) && (bin!=8)) {
        bin+=1;
      }
      if ((GPIOPinRead(GPIO_PORTJ_BASE, GPIO_PIN_1)==1) && (bin!=0)) {
        bin-=1;
      }
      
      if (binAnt!=bin){
        for(i=0; i<4; i++) {
          l[i]=0;
        }
        for(i=0; i<bin; i++){
          for(j=3; j>=0; j--){
            if (l[j]==0){
              l[j]=1;
            }
          }
        }
      }
      binAnt=bin;
      
      if (l[0]==1){
        GPIOPinWrite(GPIO_PORTN_BASE, GPIO_PIN_1, GPIO_PIN_1);
      }
      else {
        GPIOPinWrite(GPIO_PORTN_BASE, GPIO_PIN_1, 0);
      } 
      if (l[1]==1){
        GPIOPinWrite(GPIO_PORTN_BASE, GPIO_PIN_0, GPIO_PIN_0);
      }
      else {
        GPIOPinWrite(GPIO_PORTN_BASE, GPIO_PIN_0, 0);
      }         
      if (l[2]==1){
        GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_4, GPIO_PIN_4);
      }
      else {
        GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_4, 0);
      }  
      if (l[3]==1){
        GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_0, GPIO_PIN_0);
      }
      else {
        GPIOPinWrite(GPIO_PORTF_BASE, GPIO_PIN_0, 0);
      }
    }
}